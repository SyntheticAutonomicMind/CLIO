# CLIO Theme: compact
# Minimal output format - less visual noise

name=compact

# Prompts - shorter prefixes
user_prompt_format={style.user_prompt}> @RESET@
agent_prefix={style.agent_label}AI: @RESET@
system_prefix={style.system_message}SYS: @RESET@
error_prefix={style.error}ERR: @RESET@

# Banner - condensed
banner_line1={style.primary}{var.agent_name}@RESET@ {style.subtle}v1.0@RESET@
banner_line2={style.subtle}Session: {style.value}{var.session_id}@RESET@
banner_line3={style.subtle}{var.routing_verb} to {style.value}{var.model}{style.subtle}{var.route_suffix}@RESET@
banner_line4={style.subtle}Type "{style.value}/help{style.subtle}" for commands.@RESET@

# Help system - minimal
help_header={style.value}{var.title}@RESET@
help_section={style.subtle}{var.section}@RESET@
help_command={style.prompt_indicator}{var.command}@RESET@

# Status indicators - minimal
thinking_indicator={style.subtle}...@RESET@

# Navigation - brief
nav_next={style.prompt_indicator}N@RESET@
nav_previous={style.prompt_indicator}P@RESET@
nav_quit={style.prompt_indicator}Q@RESET@
pagination_info={style.subtle}{var.info}@RESET@

# Pagination prompts (single-line pause format)
pagination_hint_streaming=
pagination_hint_full=
pagination_prompt_streaming={style.subtle}{char.bullet} {style.agent_label}Q{style.subtle} {char.pipe} more @RESET@
pagination_prompt={style.subtle}{char.bullet} {style.value}{var.current}/{var.total} {style.subtle}{char.pipe} {var.nav_hint}{style.agent_label}Q{style.subtle} {char.pipe} more @RESET@

# Input prompts (box-drawing - compact style)
input_prompt={style.subtle}{char.topleft}{char.horizontal}{char.horizontal}{char.tleft} {style.prompt_indicator}{var.prompt}@RESET@
input_prompt_with_default={style.subtle}{char.topleft}{char.horizontal}{char.horizontal}{char.tleft} {style.prompt_indicator}{var.prompt} ({style.value}↵{style.subtle}={var.default_action})@RESET@

# Confirmation prompts (minimal box-drawing)
confirmation_prompt={style.subtle}{char.bullet} {style.prompt_indicator}{var.question}{style.subtle} {style.value}{var.options} {style.subtle}[{style.value}Enter{style.subtle}={var.default_action}]: @RESET@
confirmation_prompt_no_options={style.subtle}{char.bullet} {style.prompt_indicator}{var.question}{style.subtle} [{style.value}Enter{style.subtle}={var.default_action}]: @RESET@
confirmation_prompt_short={style.subtle}{char.bullet} {style.prompt_indicator}{var.question}{style.subtle}: @RESET@

# Security prompts (command/script approval)
security_prompt={style.subtle}{char.bullet} {style.warning}Security{style.subtle} {char.pipe} {style.value}{var.target}{style.subtle}@RESET@
security_prompt_input={style.subtle}  {style.value}{var.options}{style.subtle}: @RESET@

# Messages - no prefixes, just color differentiation
user_message_prefix={style.user_text}@RESET@
agent_message_prefix={style.agent_text}@RESET@

# Tool display format
tool_display_format=inline

# Layout knobs
separator_repeat=20
indent_width=2
show_timestamps=0

# Create or load session
# Both 'new' and 'chat' modes create a new session
if ($mode eq 'new' || $mode eq 'chat') {
    my $eval_err;
    eval {
        $session = CLIO::Session::Manager->create(
            debug => $debug,
            working_directory => $working_dir
        );
    };
    $eval_err = $@;
    if ($debug) {
        require Data::Dumper;
        log_debug('Main', 'Session object after create: ' . Data::Dumper::Dumper($session));
        log_debug('Main', 'session_id after create: ' . (defined $session ? $session->{session_id} // '[undef]' : '[no session]'));
        log_debug('Main', "Error during create: $eval_err") if $eval_err;
    }
    $session_id = $session->{session_id} // ($session->{state} ? $session->{state}->{session_id} : undef) if $session;
    log_debug('Main', "Created new session: $session_id") if $session_id;
    log_debug('Main', 'After new: session defined? ' . (defined $session ? 'yes' : 'no'));
    
    # NOTE: The system prompt is NOT added to session history at
    # session creation. WorkflowOrchestrator::process_input builds
    # a fresh system prompt (with tools + LTM + user_context) on
    # every turn and prepends it to the messages array. Adding the
    # system prompt to history on top of that would double the
    # per-turn prompt cost (observed in session
    # 6b09ac2d-b4e7-4f7b-8943-eb448449227a, 2026-08-29 on Ayaneo
    # Flip with 64K Qwen3.6-35B-A3B-UD-Q4_K_XL: a 71,949-char
    # system prompt in history + a fresh 80,973-char system prompt
    # on top = 152K chars = ~76K tokens, blowing past the
    # 65,536-token context window on iteration 9).
    #
    # The previous "add system prompt to session history ONCE"
    # comment was misguided - history is the durable record of
    # what was said, not a place to anchor the system prompt. The
    # system prompt is rebuilt fresh on every turn and the
    # persisted copy in history was dead weight that cost the model
    # ~36K tokens per turn before the regex/anchor fix would even
    # start to help. See also the system-prompt-as-thread_summary
    # fix in ConversationManager.pm.
} elsif ($mode eq 'resume') {
    my $eval_err;
    if ($session_id) {
        # Resolve session identifier: can be UUID, friendly name, or list number
        my $resolved_id = _resolve_session_id($session_id, $debug);
        if ($resolved_id) {
            $session_id = $resolved_id;
            eval {
                $session = CLIO::Session::Manager->load($session_id, debug => $debug);
            };
            $eval_err = $@;
            log_debug('Main', "Error during load by id: $eval_err") if $eval_err;
            log_debug('Main', 'After load by id: session defined? ' . (defined $session ? 'yes' : 'no'));
            if (!$session) {
                print "[ERROR] Failed to load session $session_id\n";
            }
        } else {
            print "[ERROR] No session found matching: $session_id\n";
            print "Use 'clio --sessions' to list available sessions.\n";
        }
    } else {
        # Resume most recent session if no ID provided
        # Sort by file modification time (mtime), not creation timestamp, to ensure most recently used session is loaded
        # When a session is resumed and exited gracefully, its mtime is updated, so mtime tracks actual usage
        my $sessions_dir = CLIO::Util::PathResolver::get_sessions_dir();
        opendir(my $dh, $sessions_dir) or die "Cannot open sessions dir: $!";
        my @json_files = grep { /\.json$/ } readdir($dh);
        closedir($dh);
        
        if (@json_files) {
            # Load all sessions and sort by file modification time (mtime)
            my @sessions_with_mtime = ();
            foreach my $json_file (@json_files) {
                my $sid = $json_file;
                $sid =~ s/\.json$//;
                my $file_path = "$sessions_dir/$json_file";
                # Use file stat to get mtime (more reliable than stored timestamp)
                my @stat = stat($file_path);
                my $mtime = $stat[9] // 0;  # 9 is the mtime field
                push @sessions_with_mtime, { id => $sid, mtime => $mtime, path => $file_path };
            }
            
            # Sort by modification time in descending order (most recent first)
            @sessions_with_mtime = sort { $b->{mtime} <=> $a->{mtime} } @sessions_with_mtime;
            
            if (@sessions_with_mtime) {
                $session_id = $sessions_with_mtime[0]->{id};
                eval {
                    $session = CLIO::Session::Manager->load($session_id, debug => $debug);
                };
                $eval_err = $@;
                log_debug('Main', "Error during load most recent: $eval_err") if $eval_err;
                log_debug('Main', 'After load most recent: session defined? ' . (defined $session ? 'yes' : 'no'));
                if (!$session) {
                    print "[ERROR] Failed to load most recent session $session_id\n";
                }
            }
        }
    }
    # Always fallback to new session if loading failed
    if (!$session) {
        eval {
            $session = CLIO::Session::Manager->create(debug => $debug);
        };
        $eval_err = $@;
        $session_id = $session->{session_id} // ($session->{state} ? $session->{state}->{session_id} : undef) if $session;
        log_debug('Main', "Created new session (fallback): $session_id") if $session_id;
        log_debug('Main', "Error during fallback create: $eval_err") if $eval_err;
        log_debug('Main', 'After fallback create: session defined? ' . (defined $session ? 'yes' : 'no'));
        
        # NOTE: System prompt is NOT added to session history here either.
        # See the comment in the 'new' branch above for the full rationale.
        # WorkflowOrchestrator::process_input builds a fresh system prompt
        # on every turn.
    } else {
        $session_id = $session->{session_id} // ($session->{state} ? $session->{state}->{session_id} : undef);
        log_debug('Main', "Resumed session: $session_id");
        
        # CRITICAL: Apply session's saved model/provider to config, but ONLY
        # if there are explicit session-only overrides (from /api set --session).
        # Global config changes between sessions should always take effect.
        # selected_model is a runtime record (not a user preference) and
        # should not override global config.
        my $session_state = $session->state();
        if ($session_state && $session_state->{api_config}) {
            my $session_api = $session_state->{api_config};
            
            # Only apply session overrides if they exist (session-only settings)
            my $session_model = $session_api->{model};
            my $session_provider = $session_api->{provider};
            
            if ($session_provider || $session_model) {
                # Session has explicit overrides - apply them
                if ($session_provider) {
                    require CLIO::Providers;
                    if (CLIO::Providers::provider_exists($session_provider)) {
                        $config->set_provider($session_provider);
                        delete $config->{user_set}->{provider};
                        delete $config->{user_set}->{api_base};
                        delete $config->{user_set}->{api_key};
                        log_debug('Main', "Session override: provider '$session_provider'");
                    }
                }
                
                if ($session_model) {
                    # If model has provider prefix, load that provider first
                    if (!$session_provider && $session_model =~ m{^([a-z][a-z0-9_.-]*)/}i) {
                        my $model_provider = $1;
                        require CLIO::Providers;
                        if (CLIO::Providers::provider_exists($model_provider)) {
                            $config->set_provider($model_provider);
                            delete $config->{user_set}->{provider};
                            delete $config->{user_set}->{api_base};
                            delete $config->{user_set}->{api_key};
                        }
                    }
                    
                    $config->set('model', $session_model, 0);
                    log_debug('Main', "Session override: model '$session_model'");
                }
            } else {
                log_debug('Main', 'No session-only overrides, using global config');
            }
        }
    }
}

log_debug('Main', 'Before session check: session defined? ' . (defined $session ? 'yes' : 'no'));
if (!$session) {
    print "[ERROR] Could not create or load a session. Exiting.\n";
    exit 2;
}
log_debug('Main', "Using session: $session_id");

# Check for broker coordination (sub-agent mode)
my $broker_client;
my $broker_session = $ENV{CLIO_BROKER_SESSION} || '';
my $broker_agent_id = $ENV{CLIO_BROKER_AGENT_ID} || '';

log_debug('Broker', "Checking env vars: SESSION=$broker_session, AGENT=$broker_agent_id");

if ($broker_session && $broker_agent_id) {
    log_info('Broker', 'Detected sub-agent mode (broker env vars present)');
    log_info('Broker', "Broker session: $broker_session");
    log_info('Broker', "Agent ID: $broker_agent_id");
    
    eval {
        require CLIO::Coordination::Client;
        $broker_client = CLIO::Coordination::Client->new(
            session_id => $broker_session,
            agent_id => $broker_agent_id,
            task => $input || "Unnamed task",
            debug => $debug,
        );
        log_info('Broker', 'Connected to broker successfully');
    };
    if ($@) {
        log_warning('Broker', "Could not connect to broker: $@");
        log_warning('Broker', 'Continuing without coordination');
    }
} else {
    log_debug('Broker', 'No broker env vars, running standalone');
}

# Set LTM corroboration identity BEFORE any tool runs.
# add_corroboration() in CLIO::Memory::LongTerm reads $ENV{CLIO_AGENT_ID}
# and $ENV{CLIO_SESSION_ID} as the source key for sybil-resistant dedup.
# Without these assignments, every corroboration collapses to
# "unknown:unknown" and the dedup check silently prevents reaching the
# 2-source threshold for promotion to [TRUSTED]. See
# tests/unit/test_ltm_corroboration.pl for the regression.
#
# Identity model: top-level CLIO is agent "main" and sub-agents inherit
# their broker agent_id. Two sessions of the same agent count as different
# sources (matches the existing agent:session dedup key), so a fresh
# `clio --new` session can corroborate entries written by a previous
# session - this matches the threat model (a session restart is a real
# barrier, not a free vote).
$ENV{CLIO_AGENT_ID}   = $ENV{CLIO_BROKER_AGENT_ID} || 'main';
$ENV{CLIO_SESSION_ID} = $session_id;
log_debug('Main', "LTM identity: CLIO_AGENT_ID=$ENV{CLIO_AGENT_ID} CLIO_SESSION_ID=$ENV{CLIO_SESSION_ID}");

# Ensure model has provider/ prefix (backward compatibility for bare model names)
{
    my $current_model = $config->get('model') || '';
    my $current_provider = $config->get('provider') || '';
    
    if ($current_model && $current_provider) {
        require CLIO::Providers;
        my $has_prefix = 0;
        if ($current_model =~ m{^([a-z][a-z0-9_.-]*)/}i) {
            $has_prefix = CLIO::Providers::provider_exists($1);
        }
        
       unless ($has_prefix) {
            # If model is just a provider name (placeholder), don't double-prefix it.
            # APIManager::get_current_model will resolve it lazily via _resolve_model_placeholder.
            if (CLIO::Providers::provider_exists($current_model) && $current_model eq $current_provider) {
                log_debug('Main', "Model '$current_model' is a provider placeholder - letting APIManager resolve it");
            } else {
               my $full_model = "$current_provider/$current_model";
               $config->set('model', $full_model, 0);
               log_debug('Main', "Added provider prefix to model: $full_model");
            }
       }
    }
}

# Apply --model override if specified (temporary, not persisted to config file)
if ($model_override) {
    require CLIO::Providers;
    my $target_provider;
    
    # Check for explicit provider prefix (e.g. "openrouter/deepseek-r1")
    if ($model_override =~ m{^([a-z][a-z0-9_.-]*)/(.+)$}i &&
        CLIO::Providers::provider_exists($1)) {
        $target_provider = $1;
        $model_override = $2;  # Strip prefix; will be re-added below
    }
    
    # If no provider prefix, use current config provider (consistent with /api set model)
    $target_provider //= $config->get('provider');
    
    unless ($target_provider) {
        die "--model requires provider/model format (e.g. --model github_copilot/gpt-4.1)\n";
    }
    
    # Load provider config (api_base, api_key, etc.) only if switching providers
    my $current_provider = $config->get('provider');
    if ($target_provider ne ($current_provider // '')) {
        # Load provider config directly without touching user_set flags.
        # set_provider() would mark provider as user_set, and deleting those
        # flags afterward also removes the ORIGINAL user-configured provider,
        # causing config.json to lose provider on next save.
        my $pcfg = CLIO::Providers::get_provider($target_provider);
        $config->{config}->{provider} = $target_provider;

        # Load api_base: stored override first, then provider default
        my $pbase = $config->get_provider_base($target_provider);
        $config->{config}->{api_base} = $pbase || $pcfg->{api_base};

        # Load per-provider API key if available
        my $pkey = $config->get_provider_key($target_provider);
        $config->{config}->{api_key} = $pkey if $pkey;

        log_debug('Main', "Temporarily switched to provider '$target_provider' (from --model)");
    }

    # Apply model override with provider prefix
    $model_override = "$target_provider/$model_override";
    $config->set('model', $model_override, 0);  # 0 = don't persist

    # Clear route_name since --model overrides any --route activation
    if (!$route_name) {
        $config->set('route_name', undef, 0);
    }
    log_info('Main', "Using temporary model: $model_override");
}

# Initialize API manager and AI agent
# Skip if no provider is configured - CLIO starts in setup mode
my $api;
my $ai_agent;
unless ($no_provider) {
    $api = CLIO::Core::APIManager->new(
        debug => $debug,
        session => $session->state(),
        config => $config,
        broker_client => $broker_client,  # Pass broker client for API rate limiting coordination
    );
    $ai_agent = CLIO::Core::SimpleAIAgent->new(
        debug => $debug,
        session => $session,
        api => $api,
        skip_custom => $skip_custom,
        skip_ltm => $skip_ltm,
        broker_client => $broker_client,  # Pass broker client for coordination
        non_interactive => $input ? 1 : 0,  # Non-interactive mode when --input is used
        enable_tools => $enable_tools,      # --enable: allowlist of tools
        disable_tools => $disable_tools,    # --disable: blocklist of tools
        prompt_override => $prompt_override, # --prompt: system prompt name override
        chat_mode => ($mode eq 'chat' ? 1 : 0),  # Chat mode flag
    );
}

if ($debug) {
    my $cfg = $config->get_all();
    log_debug('Main', 'API base: ' . ($cfg->{api_base} || '(not set)'));
    log_debug('Main', 'Model: ' . ($cfg->{model} || '(not set)'));
    if ($skip_custom || $skip_ltm) {
        log_debug('Main', "Incognito mode: skip_custom=$skip_custom, skip_ltm=$skip_ltm");
    }
}

# Handle command line input if provided
if ($input) {
    # Detach STDIN from TTY in --input mode to prevent terminal I/O
    # interference (ReadKey, cbreak mode, etc.) that causes hangs
    open(STDIN, '<', '/dev/null') if -t STDIN;
    
    my $last_response = '';  # Track last response for broker completion
    
    # Create UI for tool output formatting even in --input mode
    require CLIO::UI::Chat;
    my $cli_ui = CLIO::UI::Chat->new(
        session => $session,
        ai_agent => $ai_agent,
        config => $config,
        debug => $debug,
        no_color => $no_color
    );
    $ai_agent->set_ui($cli_ui) if $ai_agent;
    
    # Wire broker relay for puppeteer child agents
    # This forwards HostProtocol state events through the broker to the primary agent
    if ($broker_client && $ENV{CLIO_PUPPETEER} && $cli_ui->{host_proto}) {
        $cli_ui->{host_proto}->set_broker_relay($broker_client);
    }

    # Handle slash commands locally (don't send to AI)
    if ($input =~ /^\/(\S+)/) {
        my $cmd_name = lc($1);
        if ($cmd_name eq 'help' || $cmd_name eq 'h' || $cmd_name eq '?') {
            my $_agent_name = $ENV{CLIO_AGENT_NAME} || 'CLIO';
            print "[SYSTEM] $_agent_name Slash Commands (full list):\n\n";

            print "  [CORE]\n";
            print "    /help, /h, /?            Display this help\n";
            print "    /exit, /quit, /q         Exit $_agent_name\n";
            print "    /reset                   Reset the current session\n";
            print "    /debug                   Toggle debug mode\n";
            print "    /color                   Toggle ANSI color output\n";
            print "    /clear, /cls             Clear screen\n\n";

            print "  [CONFIG]\n";
            print "    /config                  Show / set configuration\n";
            print "    /api                     Provider / API status\n";
            print "    /model <name>            Switch model\n";
            print "    /models                  List available models\n";
            print "    /prompt <name>           Switch system prompt\n";
            print "    /style [set|list|preview]    Style management\n";
            print "    /theme [set|list|preview]    Theme management\n";
            print "    /loglevel <level>        Set log level\n";
            print "    /log [N]                 Show recent log lines\n\n";

            print "  [SESSIONS]\n";
            print "    /session                 Show session ID / manage\n";
            print "    /switch                  List and switch sessions\n";
            print "    /undo                    Undo last edit\n\n";

            print "  [SKILLS / EXTENSIONS]\n";
            print "    /skills                  Manage installed skills\n";
            print "    /mcp                     MCP server management\n";
            print "    /plugin                  Plugin management\n\n";

            print "  [PROJECT]\n";
            print "    /file                    File operations\n";
            print "    /git                     Git operations\n";
            print "    /todo                    Todo list management\n";
            print "    /diff                    Show pending diffs\n";
            print "    /commit                  Commit pending changes\n";
            print "    /exec                    Execute a command\n";
            print "    /edit                    Edit a file\n\n";

            print "  [SKILLS - callable in interactive mode]\n";
            print "    /design, /doc, /explain, /fix, /init, /review, /test\n\n";

            print "  [META]\n";
            print "    /update                  Check for updates\n";
            print "    /stats                   Usage statistics\n";
            print "    /login, /logout          Provider authentication\n";
            print "    /group                   Sub-agent management\n\n";

            print "Most commands accept sub-arguments. Run any command in\n";
            print "interactive mode (./clio) for full options and examples.\n";
        }
        elsif ($cmd_name eq 'session') {
            print "[SYSTEM] Current session: " . ($session->{session_id} || 'unknown') . "\n";
        }
        elsif ($cmd_name eq 'skills' || $cmd_name eq 'skill') {
            # Skill commands work in --input mode (no interactive required).
            require CLIO::UI::Commands::Skills;
            my $cmd = CLIO::UI::Commands::Skills->new(
                chat => $cli_ui,
                session => $session,
                debug => $debug,
            );
            my $rest = $input;
            $rest =~ s{^/\S+\s*}{};
            my @args = split /\s+/, $rest;
            $cmd->handle_skills_command(@args);
        }
        else {
            print "[SYSTEM] Unknown slash command: /$cmd_name\n";
            print "[SYSTEM] Note: Most commands only work in interactive mode\n";
        }
    }
    else {
        if (!$ai_agent) {
            print "[SYSTEM] No AI provider configured. Run CLIO interactively and use /api to set one.\n";
        } else {
        # Send input directly to AI agent
        # Set up callbacks for host protocol events (OSC) and tool tracking
        # These are normally set up in Chat.pm::_process_and_respond but
        # --input mode bypasses that path
        my %agent_context = (
            current_file => $session->{state}->{current_file},
            working_directory => $session->{state}->{working_directory},
            conversation_history => $session->{state}->{history},
        );
        
        # Wire up host protocol callbacks when the protocol is active
        if ($cli_ui && $cli_ui->{host_proto} && $cli_ui->{host_proto}->active()) {
            my $current_tool = '';
            $agent_context{on_tool_call} = sub {
                my ($tool_name) = @_;
                return unless defined $tool_name;
                return if $tool_name eq $current_tool;
                $current_tool = $tool_name;
                $cli_ui->{host_proto}->emit_status('tools');
                $cli_ui->{host_proto}->emit_tool_start($tool_name);
            };
            $agent_context{on_tool_end} = sub {
                my ($tool_name) = @_;
                return unless defined $tool_name;
                $cli_ui->{host_proto}->emit_tool_end($tool_name);
            };
        }
        
        my $result = $ai_agent->process_user_request($input, \%agent_context);

        if ($result->{success}) {
            my $response = $result->{final_response};
            $response =~ s/^\[conversation\]//;
            $response =~ s/\[\/conversation\]$//;
            $response =~ s/^\s+|\s+$//g;
            
            $last_response = $response;
            
            # Only save to session if the orchestrator didn't already save it.
            # During tool-calling workflows, WorkflowOrchestrator saves the final
            # assistant response to prevent context loss. Without this check,
            # the message gets saved twice, causing duplicate entries in history
            # that can make the model echo/repeat itself on subsequent turns.
            if (!$result->{messages_saved_during_workflow}) {
                $session->add_message('assistant', $response);
            }
            
            # Render markdown for --input mode
            use CLIO::UI::Markdown;
            use CLIO::UI::ANSI;
            my $md = CLIO::UI::Markdown->new(debug => $debug);
            my $ansi = CLIO::UI::ANSI->new(enabled => !$no_color, debug => $debug);
            
            my $rendered_response = $md->render($response);
            $rendered_response = $ansi->parse($rendered_response);
            
            print "[RESPONSE] $rendered_response\n";
            
            # Emit token usage via host protocol (OSC) for embedding/monitoring
            if ($cli_ui && $cli_ui->{host_proto} && $cli_ui->{host_proto}->active()) {
                my $billing = $session->{state}->{billing};
                if ($billing && $billing->{requests} && @{$billing->{requests}}) {
                    my $last = $billing->{requests}[-1];
                    $cli_ui->{host_proto}->emit_tokens(
                        prompt     => $last->{prompt_tokens} || 0,
                        completion => $last->{completion_tokens} || 0,
                        total      => $last->{total_tokens} || 0,
                        model      => $billing->{model} || '',
                    );
                }
                $cli_ui->{host_proto}->emit_status('idle');
            }
            
            if ($debug && @{$result->{protocols_used}}) {
                log_debug('Main', 'Tools used: ' . join(", ", @{$result->{protocols_used}}));
            }
        } else {
            my $error_msg = "[ERROR] " . join("; ", @{$result->{errors}});
            $last_response = $error_msg;
            $session->add_message('system', $error_msg);
            print "$error_msg\n";
        }
        }
    }
    
    # Save session after processing all commands
    $session->save();
    
    # Exit if --exit flag was provided
    if ($should_exit) {
        # Send completion result to broker if running as sub-agent
        if ($broker_client) {
            eval {
                # Truncate to 8KB for broker delivery; full output is in agent log
                my $broker_response = $last_response || 'Task completed (no output)';
                if (length($broker_response) > 8192) {
                    $broker_response = substr($broker_response, 0, 8192) . "\n\n[truncated - see agent log for full output]";
                }
                $broker_client->send_complete($broker_response);
                $broker_client->disconnect();
            };
            # Silently ignore broker errors on exit
        }
        
        # Stop any spinner that might still be running (safety net)
        if ($cli_ui && $cli_ui->{spinner}) {
            $cli_ui->{spinner}->stop();
        }
        exit 0;
    }
}

# If --exit is present, exit immediately after session setup (unless --input was handled above)
if ($should_exit && !$input) {
    exit 0;
}

# Otherwise, launch the clean chat UI
my $ui = CLIO::UI::Chat->new(
    session => $session,
    ai_agent => $ai_agent,
    config => $config,
    debug => $debug,
    no_color => $no_color
);

# Set UI on ai_agent so orchestrator can access it for collaboration
$ai_agent->set_ui($ui) if $ai_agent;

# Wire up automatic re-authentication callback on APIManager
# When token expires/is revoked, this triggers the interactive login flow
# reinit_api_manager() copies this callback to newly created APIManager instances
if ($api && $api->can('set_reauth_callback')) {
    my $reauth_cb = sub {
        log_info('Auth', 'Token expired/revoked, triggering re-authentication');
        
        # Display message to user
        if ($ui && $ui->can('display_system_message')) {
            $ui->display_system_message("Authentication token expired. Re-authenticating...");
        }
        
        # Run the login flow
        eval {
            require CLIO::Core::GitHubAuth;
            my $auth = CLIO::Core::GitHubAuth->new(debug => $debug);
            
            # Start device flow
            my $device_data = $auth->start_device_flow();
            
            if ($ui && $ui->can('display_system_message') && $ui->can('writeline')) {
                $ui->writeline("", markdown => 0);
                $ui->display_system_message("Your session token has expired. Please re-authorize:");
                $ui->writeline("  Visit: " . ($device_data->{verification_uri} || 'https://github.com/login/device'), markdown => 0);
                $ui->writeline("  Code:  " . ($device_data->{user_code} || '(unknown)'), markdown => 0);
                $ui->writeline("", markdown => 0);
                $ui->display_system_message("Waiting for authorization...");
            } else {
                print "\n[SYSTEM] Token expired. Please re-authorize:\n";
                print "  Visit: " . ($device_data->{verification_uri} || 'https://github.com/login/device') . "\n";
                print "  Code:  " . ($device_data->{user_code} || '(unknown)') . "\n";
                print "[SYSTEM] Waiting for authorization...\n";
            }
            
            # Poll for token
            my $github_token = $auth->poll_for_token(
                $device_data->{device_code},
                $device_data->{interval}
            );
            
            unless ($github_token) {
                if ($ui && $ui->can('display_error_message')) {
                    $ui->display_error_message("Re-authentication timed out");
                }
                return 0;
            }
            
            # Exchange for Copilot token
            my $copilot_token = $auth->exchange_for_copilot_token($github_token);
            
            # Save tokens
            $auth->save_tokens($github_token, $copilot_token);
            
            if ($ui && $ui->can('display_system_message')) {
                my $validation = eval { $auth->validate_github_token() };
                my $username = (!$@ && $validation && $validation->{username})
                    ? $validation->{username}
                    : (($copilot_token && $copilot_token->{username}) || 'unknown');
                $ui->display_system_message("Re-authenticated successfully as: $username");
            }
            
            return 1;
        };
        
        if ($@) {
            log_error('Auth', "Re-authentication failed: $@");
            if ($ui && $ui->can('display_error_message')) {
                $ui->display_error_message("Re-authentication failed: $@");
            }
            return 0;
        }
        
        return 1;
    };
    # Set on current APIManager and keep reference for reinit_api_manager to copy
    $api->set_reauth_callback($reauth_cb);
}

# Display repair notification if session history was cleaned up on resume
# This provides user-friendly feedback instead of raw debug warnings
if ($session && $session->can('state') && $session->state()) {
    my $state = $session->state();
    if ($state->can('repair_notification') && $state->repair_notification()) {
        my $message = $state->repair_notification();
        # Display as styled system message
        $ui->display_system_message($message);
    }
}

# Register signal handlers to save session on Ctrl+C or SIGTERM
# This ensures context is preserved when user interrupts the program
{
    my $session_ref = \$session;  # Capture in closure
    my $ui_ref = \$ui;            # Capture UI for styled output
    my $cleanup_done = 0;
    
    my $cleanup_handler = sub {
        my ($sig) = @_;
        return if $cleanup_done;  # Prevent multiple executions
        $cleanup_done = 1;
        
        # CRITICAL: Restore terminal mode FIRST before any output
        # Otherwise output may be corrupted or doubled
        eval {
            require CLIO::Compat::Terminal;
            CLIO::Compat::Terminal::ReadMode('restore');
        };
        
        # CRITICAL: Force output to appear immediately
        local $| = 1;
        
        # Print newline to clear any partial input line
        print "\n";
        
        # Use styled output if UI is available, otherwise plain text
        if ($$ui_ref && $$ui_ref->can('display_system_message')) {
            # Buffer system messages for grouped display
            my @messages = ("Saving session...");
            
            if ($$session_ref) {
                eval {
                    $$session_ref->save();
                    push @messages, "Session saved.";
                };
                if ($@) {
                    push @messages, "ERROR: Failed to save session: $@";
                }
            } else {
                push @messages, "WARN: No session to save";
            }
            
            # Display all messages as a single grouped output
            $$ui_ref->display_system_messages(\@messages);
        } else {
            print "SYSTEM: Saving session...\n";
            
            if ($$session_ref) {
                eval {
                    $$session_ref->save();
                    print "SYSTEM: Session saved.\n";
                };
                if ($@) {
                    log_error('Session', "Failed to save session: $@");
                }
            } else {
                log_warning('Session', 'No session to save (session object is undefined)');
            }
        }
        
        # Force STDERR flush
        STDERR->flush();
        STDOUT->flush();
        
        # Exit with code 0 for clean user-initiated exit
        exit 0;
    };
    
    $SIG{INT}  = $cleanup_handler;  # Ctrl+C
    $SIG{TERM} = $cleanup_handler;  # SIGTERM
}

# END block: Final safety net to restore terminal on ANY exit
# This catches unhandled exceptions, die calls, and other unexpected exits
END {
    eval {
        require CLIO::Compat::Terminal;
        CLIO::Compat::Terminal::ReadMode('restore');
    };
    # Silently ignore errors - we're exiting anyway
}

$ui->run();

# CRITICAL: Restore terminal mode before final session save
# This ensures terminal is in normal mode even if run() exited abnormally
eval {
    require CLIO::Compat::Terminal;
    CLIO::Compat::Terminal::ReadMode('restore');
};

# Save session after interactive mode completes
# This ensures all conversation history, including errors, is persisted
# Group all exit messages together for consistency
my @exit_messages = ("Saving session");
$session->save();
push @exit_messages, "Goodbye!";

if ($ui && $ui->can('display_system_messages')) {
    $ui->display_system_messages(\@exit_messages);
} else {
    for my $msg (@exit_messages) {
        print "SYSTEM: $msg\n";
    }
}
log_debug('Main', 'Session saved after interactive mode');

# Resolve session identifier: UUID, friendly name, or list number
# Returns the actual session UUID, or undef if not found
sub _resolve_session_id {
    my ($identifier, $debug) = @_;
    
    my $sessions_dir = CLIO::Util::PathResolver::get_sessions_dir();
    return undef unless -d $sessions_dir;
    
    opendir(my $dh, $sessions_dir) or return undef;
    my @json_files = grep { /\.json$/ } readdir($dh);
    closedir($dh);
    
    # Build session list sorted by mtime (for list number resolution)
    my @sessions;
    for my $json_file (@json_files) {
        my $sid = $json_file;
        $sid =~ s/\.json$//;
        my $file_path = "$sessions_dir/$json_file";
        my @stat = stat($file_path);
        my $mtime = $stat[9] // 0;
        
        # Extract session name via regex (avoids full decode_json on every file)
        my $name = undef;
        eval {
            open my $fh, '<:raw', $file_path or die;
            local $/;
            my $json = <$fh>;
            close $fh;
            if ($json =~ /"session_name"\s*:\s*"((?:[^"\\]|\\.)*)"/) {
                $name = $1;
            }
        };
        
        push @sessions, { id => $sid, name => $name, mtime => $mtime };
    }
    
    @sessions = sort { $b->{mtime} <=> $a->{mtime} } @sessions;
    
    # 1. Exact UUID match
    for my $s (@sessions) {
        return $s->{id} if $s->{id} eq $identifier;
    }
    
    # 2. UUID prefix match
    my @uuid_matches = grep { index($_->{id}, $identifier) == 0 } @sessions;
    if (@uuid_matches == 1) {
        log_debug('Main', "Resolved UUID prefix '$identifier' -> $uuid_matches[0]->{id}");
        return $uuid_matches[0]->{id};
    }
    
    # 3. List number (from --sessions output)
    if ($identifier =~ /^\d+$/) {
        my $idx = $identifier - 1;
        if ($idx >= 0 && $idx < @sessions) {
            log_debug('Main', "Resolved list number $identifier -> $sessions[$idx]->{id}");
            return $sessions[$idx]->{id};
        }
    }
    
    # 4. Exact friendly name match (case-insensitive)
    for my $s (@sessions) {
        next unless $s->{name};
        if (lc($s->{name}) eq lc($identifier)) {
            log_debug('Main', "Resolved name '$identifier' -> $s->{id}");
            return $s->{id};
        }
    }
    
    # 5. Friendly name prefix match (case-insensitive)
    my $lc_id = lc($identifier);
    my @name_matches = grep { $_->{name} && index(lc($_->{name}), $lc_id) == 0 } @sessions;
    if (@name_matches == 1) {
        log_debug('Main', "Resolved name prefix '$identifier' -> $name_matches[0]->{id}");
        return $name_matches[0]->{id};
    }
    
    # 6. Friendly name substring match (case-insensitive)
    my @substr_matches = grep { $_->{name} && index(lc($_->{name}), $lc_id) >= 0 } @sessions;
    if (@substr_matches == 1) {
        log_debug('Main', "Resolved name substring '$identifier' -> $substr_matches[0]->{id}");
        return $substr_matches[0]->{id};
    }
    
    # Multiple matches - report ambiguity
    if (@uuid_matches > 1 || @name_matches > 1 || @substr_matches > 1) {
        my @all_matches = @uuid_matches > 1 ? @uuid_matches : @name_matches > 1 ? @name_matches : @substr_matches;
        print "[WARN] Ambiguous session identifier '$identifier'. Matches:\n";
        for my $m (@all_matches) {
            my $display = $m->{name} || $m->{id};
            printf "  - %s (%s)\n", $display, substr($m->{id}, 0, 12);
        }
        return undef;
    }
    
    return undef;
}

# Helper function for --sessions CLI display
sub _format_relative_time_cli {
    my ($timestamp) = @_;
    return 'unknown' unless $timestamp;
    my $now = time();
    my $diff = $now - $timestamp;
    if ($diff < 60) {
        return "just now";
    } elsif ($diff < 3600) {
        my $mins = int($diff / 60);
        return "$mins min ago";
    } elsif ($diff < 86400) {
        my $hours = int($diff / 3600);
        return "$hours hr ago";
    } elsif ($diff < 604800) {
        my $days = int($diff / 86400);
        return "$days day" . ($days > 1 ? "s" : "") . " ago";
    } else {
        my @t = localtime($timestamp);
        return sprintf("%04d-%02d-%02d", $t[5]+1900, $t[4]+1, $t[3]);
    }
}

sub _fetch_models_for_provider {
    my ($provider_name, $provider_def, $api_key, $config) = @_;

    my $models = [];

    if ($provider_name eq 'github_copilot') {
        eval {
            require CLIO::Core::GitHubCopilotModelsAPI;
            my $models_api = CLIO::Core::GitHubCopilotModelsAPI->new(
                debug   => 0,
                api_key => $api_key,
            );
            my $data = $models_api->fetch_models();
            $models = $data->{data} || [] if $data;
        };
    } elsif ($provider_def->{native_api} && $provider_name eq 'google') {
        my $api_base = $provider_def->{api_base} || 'https://generativelanguage.googleapis.com/v1beta';
        $api_base =~ s{/+$}{};
        my $models_url = "$api_base/models?key=$api_key";
        eval {
            require CLIO::Compat::HTTP;
            my $ua = CLIO::Compat::HTTP->new(timeout => 15);
            my $resp = $ua->get($models_url, headers => { 'Accept' => 'application/json' });
            if ($resp->is_success) {
                my $data = CLIO::Util::JSON::decode_json($resp->decoded_content);
                for my $m (@{$data->{models} || []}) {
                    my @methods = @{$m->{supportedGenerationMethods} || []};
                    next unless grep { $_ eq 'generateContent' } @methods;
                    (my $model_id = $m->{name}) =~ s{^models/}{};
                    push @$models, {
                        id          => $model_id,
                        name        => $m->{displayName} || $model_id,
                        description => $m->{description} || '',
                    };
                }
            }
        };
    } else {
        my $api_base = $provider_def->{api_base} || '';
        my $models_url;
        if ($api_base =~ m{openrouter\.ai}i) {
            $models_url = 'https://openrouter.ai/api/v1/models';
        } elsif ($api_base =~ m{^(https?://[^/]+)}) {
            $models_url = "$1/v1/models";
        }
        return [] unless $models_url && $api_key;
        eval {
            require CLIO::Compat::HTTP;
            my $ua = CLIO::Compat::HTTP->new(timeout => 15);
            my %headers = ('Authorization' => "Bearer $api_key");
            my $resp = $ua->get($models_url, headers => \%headers);
            if ($resp->is_success) {
                my $data = CLIO::Util::JSON::decode_json($resp->decoded_content);
                $models = $data->{data} || [];
            }
        };
    }

    return $models;
}

exit 0;

#!/usr/bin/env perl
BEGIN {
    $|=1;
    use FindBin qw($RealBin);
    
    # Use $RealBin which automatically resolves symlinks
    # This ensures lib path is correct even when clio is invoked via symlink
    use lib "$RealBin/lib";
}

use strict;
use warnings;
use File::Basename;
use CLIO::Util::JSON qw(encode_json decode_json);
use CLIO::UI::Terminal qw(detect_capabilities configure_io_encoding box_char);
use CLIO::UI::ANSI;
use CLIO::UI::Chat;
use CLIO::Util::PathResolver;
use CLIO::Core::Logger qw(should_log log_info log_debug);

# Detect terminal capabilities and set IO encoding early
# This must happen before any module sets binmode
detect_capabilities();
configure_io_encoding();

# Parse early CLI options BEFORE module init (--config and --no-color)
my $config_dir_override;
my $no_color = 0;
my $no_banner = 0;
my $reduced_motion = 0;
for (my $i = 0; $i < @ARGV; $i++) {
    if ($ARGV[$i] eq '--config' && defined $ARGV[$i+1]) {
        $config_dir_override = $ARGV[$i+1];
    }
    if ($ARGV[$i] eq '--no-color') {
        $no_color = 1;
        $ENV{NO_COLOR} = 1;  # Standard env var for no-color output
    }
    if ($ARGV[$i] eq '--no-banner') {
        $no_banner = 1;
    }
    if ($ARGV[$i] eq '--reduced-motion') {
        $reduced_motion = 1;
    }
}

# Initialize path resolver early (with config override if provided)
if ($config_dir_override) {
    CLIO::Util::PathResolver::init(base_dir => $config_dir_override);
} else {
    CLIO::Util::PathResolver::init();
}

# Initialize ANSI formatter for colored output (after no_color is determined)
my $ansi = CLIO::UI::ANSI->new(enabled => !$no_color);

# Check for --help flag
if (grep { $_ eq '--help' || $_ eq '-h' } @ARGV) {
    print <<'HELP';
CLIO - Command Line Intelligent Operator
AI-Powered Development Assistant

USAGE:
    clio [OPTIONS]

OPTIONS:
    --new              Start a new session
    --resume [ID]      Resume a session (most recent if no ID provided)
    --sessions         List all sessions with friendly names
    --list-models      Output available models as JSON (for integrations)
    --list-styles      List all available terminal styles with descriptions
    --list-themes      List all available output themes with descriptions
    --list-spinners    List all available spinner animations
    --debug            Enable debug output
    --dir <path>       Set working directory for session
    --input <text>     Process input and exit
    --exit             Exit after processing (with --input)
    --model <name>     Use specific model (temporary, not persisted)
    --model "m1 m2 m3" Use multiple models with automatic fallback routing
    --route <name>     Use a saved model routing profile
    --prompt <name>    Use specific system prompt (see /prompt list)
    --enable <tools>   Only enable these tools (comma-separated)
    --disable <tools>  Disable these tools (comma-separated)
    --sandbox          Restrict file access to project directory only
    --chat             Chat mode: conversational AI with web access (sandboxed)
    --config <path>    Use custom config directory (for isolated testing)
    --no-color         Disable ANSI color output (for CI/workflows)
    --no-banner        Suppress the startup banner
    --reduced-motion   Use static indicators instead of animated spinners
    --no-custom-instructions  Skip .clio/instructions.md
    --no-ltm           Skip long-term memory pattern injection
    --incognito        Skip both custom instructions AND LTM (fresh audit mode)
    --help, -h         Display this help message

EXAMPLES:
    clio --new                    # Start new session
    clio --resume                 # Resume most recent session
    clio --resume <session_id>    # Resume specific session
    clio --resume "my session"    # Resume by friendly name
    clio --sessions               # List all sessions
    clio --debug --new            # Start with debug logging
    clio --dir /path/to/project   # Start in specific directory
    clio --model gpt-4.1 --new    # Start with specific model
    clio --model "openrouter/foo:free kilo/bar:free" --new  # Model routing with fallback
    clio --route my-route --new   # Use a saved routing profile
    clio --prompt minimal --new   # Start with a custom system prompt
    clio --enable file_operations,terminal_operations --input "list files"
    clio --disable web_operations,remote_execution --new
    clio --incognito --new        # Fresh audit without project knowledge
    clio --chat --new             # Conversational chat mode (sandboxed)
    clio --config /tmp/clio-test  # Use isolated config for testing
    clio --no-banner              # Skip startup banner
    clio --no-color --input "hi"  # Non-interactive without color
    clio --list-styles            # Browse terminal styles
    clio --list-themes            # Browse output themes
    clio --list-spinners          # Browse spinner animations

SESSIONS:
    Sessions are stored in: .clio/sessions/
    Each session has a unique UUID identifier
    Sessions can have human-friendly names (auto-generated or set via /session name)
    Use /switch command to list and switch between sessions

SLASH COMMANDS:
    Type /help in the application for available commands

ENVIRONMENT:
    CLIO_HOME          Override CLIO base directory
    NO_COLOR           Disable color output (same as --no-color)

HELP
    exit 0;
}

# Set debug level from --debug flag
# CRITICAL: Set in BEGIN block so should_log() works when modules load
BEGIN {
    if (grep { $_ eq '--debug' } @ARGV) {
        $ENV{CLIO_LOG_LEVEL} = 'DEBUG';
    }
}
my $debug = grep { $_ eq '--debug' } @ARGV ? 1 : 0;

my $input = '';
my $session_id = '';
my $mode = '';
my $working_dir = '';
my $session;
my $no_provider = 0;  # Set when CLIO starts without a configured provider

# Load required modules
use CLIO::Core::APIManager;
use CLIO::Core::SimpleAIAgent;
use CLIO::Core::Config;
use CLIO::Session::Manager;
use CLIO::Providers qw(list_providers get_provider provider_exists);

# Initialize configuration system
my $config = CLIO::Core::Config->new(debug => $debug);

# --no-banner overrides show_banner for this session only (not persisted).
if ($no_banner) {
    $config->set('show_banner', 0, 0);
}

# --reduced-motion overrides the style key for this session
if ($reduced_motion) {
    $config->set('reduced_motion', 1, 0);
}

# Pre-parse --model so we can auto-derive provider from "provider/model" prefix
# before the provider check. Without this, `clio --model nvidia/...` would hit
# the no-provider path because the full CLI parse runs *after* it.
# Also supports multiple space-separated models for model routing:
#   --model "openrouter/foo kilo/bar vercel/baz"
my $cli_model_override;
my $cli_model_candidates;
for (my $i = 0; $i < @ARGV; $i++) {
    if ($ARGV[$i] eq '--model' && defined $ARGV[$i+1]) {
        $cli_model_override = $ARGV[$i+1];
        # Split on whitespace to detect multiple models for routing
        my @parts = split(/\s+/, $ARGV[$i+1]);
        if (@parts > 1) {
            $cli_model_candidates = \@parts;
            $cli_model_override = $parts[0];  # First model for pre-parse provider detection
        }
    }
}

# Check if provider is configured - if not, prompt user to configure one
my $provider = $config->get('provider');
if ((!$provider || $provider eq '') && $cli_model_override
    && $cli_model_override =~ m{^([a-z][a-z0-9_.-]*)/(.+)$}i
    && CLIO::Providers::provider_exists($1)) {
    my $derived_provider = $1;
    # Check config first, then fall back to CLIO_API_KEY env var.
    # Env var covers non-interactive/CI/CD launches where there's no
    # persistent config file (e.g. terminal-bench task containers).
    my $api_key = $config->get_provider_key($derived_provider)
        || ($ENV{CLIO_API_KEY} && length($ENV{CLIO_API_KEY}) ? $ENV{CLIO_API_KEY} : undef);
    if ($api_key) {
        $config->set_provider($derived_provider);
        $provider = $derived_provider;
        # set_provider marks provider/model/api_base as user_set.
        # Don't delete those flags: the user has no configured provider
        # and this --model provides the first usable provider. Save it
        # so it persists across sessions.
        $config->save();
        log_info('Main', "Auto-selected provider '$provider' from --model prefix");
    }
}

# If still no provider but the user has API keys configured, auto-select
# from those keys. This avoids the "No AI Provider Configured" dead-end for
# users who set up keys via /api set key but never explicitly ran
# /api set provider. Preference order:
#   1. Providers with priority_display (github_copilot) if they have a key
#   2. Alphabetical for determinism
# The selection is persisted so subsequent launches don't hit this branch
# again - the user can change providers with /api set provider anytime.
if (!$provider || $provider eq '') {
    my @configured = $config->list_provider_keys();

    if (@configured) {
        my @candidates = sort {
            my $a_def = CLIO::Providers::get_provider($a);
            my $b_def = CLIO::Providers::get_provider($b);
            my $a_pri = ($a_def && $a_def->{priority_display}) ? 0 : 1;
            my $b_pri = ($b_def && $b_def->{priority_display}) ? 0 : 1;
            return $a_pri <=> $b_pri || $a cmp $b;
        } @configured;

        my $auto = $candidates[0];
        if ($auto && CLIO::Providers::provider_exists($auto)) {
            $config->set_provider($auto);
            $config->save();
            $provider = $auto;
            log_info('Main', "Auto-selected provider '$provider' from configured api_keys");

            # Create minimal display object for themed output
            my $display = CLIO::UI::Chat->new(no_color => $no_color, debug => $debug);
            $display->display_system_message("No provider set - auto-selected '$auto' from your configured API keys.");
            $display->display_system_message("Run '/api set provider <name>' to choose a different one.");
        }
    }
}
if (!$provider || $provider eq '') {
    # No provider configured - let CLIO start so slash commands are available.
    # The Chat UI will show an informational message, and /api commands work.
    $no_provider = 1;
}

# Apply config log_level to env if --debug wasn't used
unless ($ENV{CLIO_LOG_LEVEL}) {
    my $config_level = $config->get('log_level');
    $ENV{CLIO_LOG_LEVEL} = uc($config_level) if $config_level;
}

# Parse command line arguments
my $should_exit = 0;
my $skip_custom = 0;
my $skip_ltm = 0;
my $sandbox_mode = 0;  # Sandbox mode - restrict file access to project directory
my $model_override = undef;  # Temporary model override from --model flag
my $enable_tools = undef;   # --enable: allowlist of tools (comma-separated)
my $disable_tools = undef;  # --disable: blocklist of tools (comma-separated)
my $prompt_override = undef;  # --prompt: system prompt name override
my $route_name;                # --route: named routing profile to activate
for (my $i = 0; $i < @ARGV; $i++) {
    if ($ARGV[$i] eq '--input' && defined $ARGV[$i+1]) {
        $input = $ARGV[$i+1];
    }
    if ($ARGV[$i] eq '--dir' && defined $ARGV[$i+1]) {
        $working_dir = $ARGV[$i+1];
    }
    if ($ARGV[$i] eq '--new') {
        $mode = 'new';
    }
    if ($ARGV[$i] eq '--resume') {
        $mode = 'resume';
        # If next arg is not another flag, treat as session id
        if (defined $ARGV[$i+1] && $ARGV[$i+1] !~ /^--/) {
            $session_id = $ARGV[$i+1];
        }
    }
    if ($ARGV[$i] eq '--exit') {
        $should_exit = 1;
    }
    if ($ARGV[$i] eq '--no-custom-instructions') {
        $skip_custom = 1;
    }
    if ($ARGV[$i] eq '--no-ltm') {
        $skip_ltm = 1;
    }
    if ($ARGV[$i] eq '--incognito') {
        # Incognito mode enables both skip flags
        $skip_custom = 1;
        $skip_ltm = 1;
    }
    if ($ARGV[$i] eq '--sandbox') {
        $sandbox_mode = 1;
    }
    if ($ARGV[$i] eq '--chat') {
        $mode = 'chat';
        # Chat mode auto-enables sandbox for safety
        $sandbox_mode = 1;
    }
    if ($ARGV[$i] eq '--model' && defined $ARGV[$i+1]) {
        if ($cli_model_candidates && @$cli_model_candidates > 1) {
            $model_override = $cli_model_override;  # First model from the routing list
        } else {
            $model_override = $ARGV[$i+1];
        }
    }
    if ($ARGV[$i] eq '--enable' && defined $ARGV[$i+1]) {
        $enable_tools = $ARGV[$i+1];
    }
    if ($ARGV[$i] eq '--disable' && defined $ARGV[$i+1]) {
        $disable_tools = $ARGV[$i+1];
    }
    if ($ARGV[$i] eq '--prompt' && defined $ARGV[$i+1]) {
        $prompt_override = $ARGV[$i+1];
    }
    if ($ARGV[$i] eq '--sessions') {
        $mode = 'list_sessions';
    }
    if ($ARGV[$i] eq '--list-models') {
        $mode = 'list_models';
    }
    if ($ARGV[$i] eq '--list-styles') {
        $mode = 'list_styles';
    }
    if ($ARGV[$i] eq '--list-themes') {
        $mode = 'list_themes';
    }
    if ($ARGV[$i] eq '--route' && defined $ARGV[$i+1]) {
        $route_name = $ARGV[$i+1];
    }
    if ($ARGV[$i] eq '--list-spinners') {
        $mode = 'list_spinners';
    }
}

# Store model candidates for routing if multiple models were passed via --model
if ($cli_model_candidates && @$cli_model_candidates > 1) {
    # Store as transient (0 => don't mark as user_set, won't persist to config file)
    # consistent with how $model_override is handled below
    $config->set('model_candidates', $cli_model_candidates, 0);
    $config->set('model_routing_index', 0, 0);
    log_debug('Main', "Model routing enabled with " . scalar(@{$cli_model_candidates}) . " candidates");
}

# Load a named routing profile (--route <name>)
if ($route_name && length($route_name)) {
    my $routes = { $config->list_model_routes() };
    if (exists $routes->{$route_name}) {
        my $models = $routes->{$route_name};
        if (@$models >= 1) {
            $config->set('route_name', $route_name, 0);
            $config->set('model_candidates', $models, 0);
            $config->set('model_routing_index', 0, 0);
            # Resolve provider from first model BEFORE setting the model,
            # because set_provider() overwrites model with the provider's
            # default model (e.g. OpenRouter defaults to meta-llama/...).
            if ($models->[0] =~ m{^([a-z][a-z0-9_.-]*)/(.+)$}i && CLIO::Providers::provider_exists($1)) {
                my $rp = $1;
                my $rpkey = $config->get_provider_key($rp);
                if ($rpkey) {
                    $config->set_provider($rp);
                    $provider = $rp;
                    log_info('Main', "Activated route '$route_name' with provider '$rp'");
                }
            }
            # Set model AFTER provider so set_provider's default model
            # doesn't clobber the route's first model
            $config->set('model', $models->[0], 0);
            log_debug('Main', "Route '$route_name' loaded with " . scalar(@$models) . " models");
        }
    } else {
        print STDERR "Unknown route: $route_name\n";
        print STDERR "Available routes: " . join(", ", sort keys %{$routes}) . "\n" if %$routes;
        exit 1;
    }
}

# Validate --enable and --disable are mutually exclusive
if (defined $enable_tools && defined $disable_tools) {
    print STDERR "Error: --enable and --disable are mutually exclusive. Use one or the other.\n";
    exit 1;
}

# If no --input flag was provided but STDIN is piped (not a TTY), read from STDIN
if (!$input && !-t STDIN) {
    my $piped_input = '';
    while (my $line = <STDIN>) {
        $piped_input .= $line;
    }
    $input = $piped_input;
    chomp $input;
    log_debug('Main', 'Read ' . length($input) . ' bytes from piped STDIN');
}

# Default to 'new' mode if not specified
if (!$mode) {
    log_debug('Main', "No mode specified, defaulting to 'new'");
    $mode = 'new';
}
log_debug('Main', "Mode before session creation: $mode");

# Set sandbox mode in config (runtime only, not persisted)
if ($sandbox_mode) {
    $config->set('sandbox', 1, 0);  # 0 = don't mark as user-set (not persisted)
    log_debug('Main', 'Sandbox mode enabled - file access restricted to project directory');
}

# Handle --sessions mode (list and exit)
if ($mode eq 'list_sessions') {
    my $sessions_dir = CLIO::Util::PathResolver::get_sessions_dir();
    
    unless (-d $sessions_dir) {
        print "No sessions directory found.\n";
        exit 0;
    }
    
    opendir(my $dh, $sessions_dir) or die "Cannot open sessions dir: $!";
    my @json_files = grep { /\.json$/ } readdir($dh);
    closedir($dh);
    
    unless (@json_files) {
        print "No sessions found.\n";
        exit 0;
    }
    
    # Collect session info
    my @sessions_info;
    for my $json_file (@json_files) {
        my $sid = $json_file;
        $sid =~ s/\.json$//;
        my $file_path = "$sessions_dir/$json_file";
        my @stat = stat($file_path);
        my $mtime = $stat[9] // 0;
        my $size = $stat[7] // 0;
        
        my $name = undef;
        my $model = undef;
        my $msg_count = 0;
        my $total_tokens = 0;
        eval {
            open my $fh, '<:raw', $file_path or die;
            local $/;
            my $json = <$fh>;
            close $fh;
            # Regex extraction avoids full decode_json on every file
            if ($json =~ /"session_name"\s*:\s*"((?:[^"\\]|\\.)*)"/) {
                $name = $1;
            }
            if ($json =~ /"billing"\s*:\s*\{[^}]*?"model"\s*:\s*"((?:[^"\\]|\\.)*)"/s) {
                $model = $1;
            }
            if ($json =~ /"total_requests"\s*:\s*(\d+)\s*,\s*"total_tokens"\s*:\s*(\d+)/s) {
                $total_tokens = $2;
            }
            # Count messages by counting "role" keys in history
            $msg_count = () = $json =~ /"role"\s*:/g;
        };
        
        push @sessions_info, {
            id => $sid,
            name => $name,
            model => $model,
            mtime => $mtime,
            size => $size,
            msg_count => $msg_count,
            total_tokens => $total_tokens,
        };
    }
    
    # Sort by modification time (most recent first)
    @sessions_info = sort { $b->{mtime} <=> $a->{mtime} } @sessions_info;
    
    # ANSI codes for terminal display
    my $bold = "\e[1m";
    my $dim  = "\e[2m";
    my $reset = "\e[0m";
    
    # Display in multi-line format matching /session list
    for my $i (0 .. $#sessions_info) {
        my $s = $sessions_info[$i];
        my $display_name = $s->{name} || '(unnamed)';
        my $time_str = _format_relative_time_cli($s->{mtime});
        
        # Format model name (strip date suffix and provider prefix)
        my $short_model = '';
        if ($s->{model}) {
            $short_model = $s->{model};
            $short_model =~ s/-20\d{6}$//;
            $short_model =~ s{^[a-z][a-z0-9_.-]*/}{}i;
        }
        
        # Format token count
        my $tk_fmt = '';
        if ($s->{total_tokens} > 0) {
            my $tk = $s->{total_tokens};
            if ($tk >= 1_000_000) {
                $tk_fmt = sprintf("%.1fM tokens", $tk / 1_000_000);
            } elsif ($tk >= 1_000) {
                $tk_fmt = sprintf("%.0fK tokens", $tk / 1_000);
            } else {
                $tk_fmt = "$tk tokens";
            }
        }
        
        # Line 1: full session name (no truncation)
        printf "${bold}%s${reset}\n", $display_name;
        
        # Line 2: time, model, tokens
        my @details;
        push @details, $time_str;
        push @details, "via $short_model" if $short_model;
        push @details, $tk_fmt if $tk_fmt;
        printf "  ${dim}%s${reset}\n", join(", ", @details);
        
        # Line 3: session ID
        printf "  ${dim}ID: %s${reset}\n", $s->{id};
    }
    
    print "\nResume a session:\n";
    print "  clio --resume <name>         # by friendly name\n";
    print "  clio --resume <uuid>         # by session ID\n";
    
    exit 0;
}

# Handle --list-models mode (output JSON and exit)
if ($mode eq 'list_models') {
    require CLIO::Providers;
    require CLIO::Util::JSON;

    my @all_models;

    my @providers = CLIO::Providers::list_providers();
    for my $provider_name (@providers) {
        my $provider_def = CLIO::Providers::get_provider($provider_name);
        next unless $provider_def;

        my $api_key = $config->get_provider_key($provider_name);
        my $has_auth = $api_key
            || $provider_name eq 'github_copilot'
            || $provider_name eq 'sam'
            || $provider_name eq 'llama.cpp'
            || $provider_name eq 'lmstudio';

        if ($provider_name eq 'github_copilot' && !$api_key) {
            eval {
                require CLIO::Core::GitHubAuth;
                my $auth = CLIO::Core::GitHubAuth->new(debug => 0);
                $api_key = $auth->get_copilot_token();
                $has_auth = 1 if $api_key;
            };
            $has_auth = 0 unless $api_key;
        }

        next unless $has_auth;

        my $models = _fetch_models_for_provider($provider_name, $provider_def, $api_key, $config);
        next unless $models && @$models;

        for my $m (@$models) {
            push @all_models, {
                id       => $m->{id},
                name     => $m->{name} || $m->{id},
                provider => $provider_name,
                provider_display => $provider_def->{name} || $provider_name,
                full_id  => "$provider_name/$m->{id}",
                ($m->{vendor}      ? (vendor      => $m->{vendor})      : ()),
                ($m->{description} ? (description => $m->{description}) : ()),
                ($m->{billing}     ? (billing     => $m->{billing})     : ()),
                ($m->{model_picker_enabled}  ? (picker_enabled  => \1) : ()),
                ($m->{model_picker_category} ? (picker_category => $m->{model_picker_category}) : ()),
                ($m->{preview}     ? (preview     => \1) : ()),
                ($m->{capabilities} ? (capabilities => $m->{capabilities}) : ()),
            };
        }
    }

    print CLIO::Util::JSON::encode_json(\@all_models);
    print "\n";
    exit 0;
}

# Helper: extract description from the leading comment block of a .style file.
# Style files start with a # header comment like:
#   # CLIO Style: dracula
#   # Dracula - Dark Theme with Vibrant Colors
#   #
#   # Color Philosophy:
#   # - ...
# Returns the second-line tagline (the description), or undef if not found.
sub _extract_style_description {
    my ($path) = @_;
    return undef unless -r $path;
    open my $fh, '<:encoding(UTF-8)', $path or return undef;
    my @header = ();
    while (my $line = <$fh>) {
        last unless $line =~ /^#/;
        chomp $line;
        $line =~ s/^#\s*//;
        push @header, $line;
    }
    close $fh;
    # Skip the first header line ("CLIO Style: <name>") and the section
    # dividers (lines made of box-drawing chars). Return the first
    # substantive tagline.
    for my $i (1 .. $#header) {
        my $line = $header[$i];
        next if $line =~ /^[\s\-\=\u2500-\u257f]*$/;   # dividers / blanks
        next if $line =~ /^Color Philosophy/i;
        next if $line =~ /^Based on /i;
        return $line;
    }
    return undef;
}

# Helper: group a style name into a coarse category for display.
sub _style_category {
    my ($name) = @_;
    my %categories = (
        modern  => [qw(console default dark greyscale light slate
                       solarized-dark solarized-light nord dracula)],
        retro   => [qw(amber-terminal apple-ii bbs-bright commodore-64
                       dos-blue green-screen photon retro-rainbow vt100)],
        flair   => [qw(monokai synthwave cyberpunk matrix ocean forest)],
    );
    for my $cat (keys %categories) {
        return $cat if grep { $_ eq $name } @{$categories{$cat}};
    }
    return 'other';
}

# Handle --list-styles mode (browse all terminal styles)
if ($mode eq 'list_styles') {
    require CLIO::UI::Theme;
    # $RealBin is already in scope from the top-of-file `use FindBin qw($RealBin)`.

    my $theme = CLIO::UI::Theme->new(debug => 0);
    my @styles = $theme->list_styles();

    my $bold = "\e[1m";
    my $dim  = "\e[2m";
    my $cyan = "\e[36m";
    my $green = "\e[32m";
    my $reset = "\e[0m";

    print "${bold}CLIO Styles${reset} ${dim}(", scalar(@styles), " available)${reset}\n";
    print "${dim}\x{2550}" x 70 . "${reset}\n\n";

    # Group styles by category and print in canonical order: modern, retro, flair, other.
    my %by_cat;
    for my $style (@styles) {
        push @{$by_cat{_style_category($style)}}, $style;
    }

    my @cat_order = qw(modern retro flair other);
    my @cat_labels = (
        modern => 'Modern',
        retro  => 'Retro',
        flair  => 'Flair/Nature',
        other  => 'Other',
    );
    while (@cat_labels) {
        my $cat = shift @cat_labels;
        my $label = shift @cat_labels;
        my $items = $by_cat{$cat} || [];
        next unless @$items;
        print "${cyan}${bold}${label}${reset}\n";
        for my $style (@$items) {
            # Locate the source file to extract the description.
            my $path = "$RealBin/styles/$style.style";
            my $desc = _extract_style_description($path) // '(no description)';
            printf "  ${green}*${reset} ${bold}%-22s${reset} ${dim}%s${reset}\n",
                $style, $desc;
        }
        print "\n";
    }

    print "${dim}Use:${reset}\n";
    print "  ${green}clio --style <name>${reset}      ${dim}# one-shot session${reset}\n";
    print "  ${green}/config style <name>${reset}    ${dim}# set as default${reset}\n";

    exit 0;
}


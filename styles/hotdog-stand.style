# CLIO Style: hotdog-stand
# Hotdog Stand - Classic Carnival/Fair Food Stand
#
# Color Philosophy:
# - Warm, nostalgic fairground energy
# - Mustard yellow, ketchup red, relish green
# - Bun beige, napkin white, grill marks
# - Fun, approachable, slightly messy
#
# Based on Consolidated Style Schema v2.0

name=hotdog-stand

# ═══════════════════════════════════════════════════════════════
# CORE SEMANTIC HIERARCHY
# ═══════════════════════════════════════════════════════════════

primary=@BOLD@@BRIGHT_YELLOW@
secondary=@BRIGHT_RED@
normal=@YELLOW@
muted=@DIM@@YELLOW@
subtle=@DIM@

# ═══════════════════════════════════════════════════════════════
# CONVERSATIONAL
# ═══════════════════════════════════════════════════════════════

user_prompt=@BRIGHT_RED@
user_text=@WHITE@
agent_label=@BRIGHT_YELLOW@
agent_text=@WHITE@
system_message=@BRIGHT_GREEN@

# ═══════════════════════════════════════════════════════════════
# FEEDBACK MESSAGES
# ═══════════════════════════════════════════════════════════════

error=@BRIGHT_RED@
warning=@BRIGHT_YELLOW@
success=@BRIGHT_GREEN@
info=@BRIGHT_CYAN@

# ═══════════════════════════════════════════════════════════════
# DATA DISPLAY
# ═══════════════════════════════════════════════════════════════

label=@DIM@@YELLOW@
value=@BRIGHT_YELLOW@

# ═══════════════════════════════════════════════════════════════
# ACTIONABLE ELEMENTS
# ═══════════════════════════════════════════════════════════════

command=@BRIGHT_RED@
link=@BRIGHT_CYAN@@UNDERLINE@

# ═══════════════════════════════════════════════════════════════
# PROMPT
# ═══════════════════════════════════════════════════════════════

prompt_model=@BRIGHT_GREEN@
prompt_directory=@BRIGHT_YELLOW@
prompt_git_branch=@BRIGHT_RED@
prompt_indicator=@BRIGHT_RED@

# ═══════════════════════════════════════════════════════════════
# MARKDOWN
# ═══════════════════════════════════════════════════════════════

markdown_h1=@BOLD@@BRIGHT_YELLOW@
markdown_h2=@BRIGHT_RED@
markdown_h3=@WHITE@
markdown_bold=@BOLD@
markdown_italic=@DIM@
markdown_code=@BRIGHT_CYAN@
markdown_code_block=@BRIGHT_CYAN@
markdown_link=@BRIGHT_CYAN@@UNDERLINE@
markdown_quote=@DIM@@GREEN@
markdown_list_bullet=@BRIGHT_RED@

# ═══════════════════════════════════════════════════════════════
# TABLES
# ═══════════════════════════════════════════════════════════════

table_header=@BOLD@@BRIGHT_YELLOW@
table_border=@DIM@@YELLOW@

# ═══════════════════════════════════════════════════════════════
# UI ELEMENTS
# ═══════════════════════════════════════════════════════════════

spinner_style=dots

# Accessibility
reduced_motion=0
high_contrast=0

# ═══════════════════════════════════════════════════════════════
